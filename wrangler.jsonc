{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomat-web",
  "main": "./scripts/docs-worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tomat.cc", "custom_domain": true },
    { "pattern": "www.tomat.cc", "custom_domain": true },
  ],
  "assets": {
    "directory": "./docs/book",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
